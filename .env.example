# 飞书自建应用（open.feishu.cn）
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# 多维表格：URL 里 /base/<app_token>?table=<table_id>
FEISHU_BITABLE_APP_TOKEN=
FEISHU_BITABLE_TABLE_ID=

# 通知发到哪个群（用应用自带的机器人，机器人需已在群里）：oc_ 开头的群 id
FEISHU_CHAT_ID=

# 可选：不用应用机器人时，改用群自定义机器人 Webhook（FEISHU_CHAT_ID 为空才生效）
FEISHU_BOT_WEBHOOK=
FEISHU_BOT_SECRET=

# fake（默认，内存模拟）或 real（真实飞书）
FEISHU_MODE=fake

# Shopify webhook 签名密钥
SHOPIFY_WEBHOOK_SECRET=

# 本地存储
SQLITE_PATH=./data/orders.db
